<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BitLifeClone.MainWindow"
        Title="BitLife Clone"
        Width="600" Height="400">

    <Grid>
        <!-- Setup Screen -->
        <StackPanel Name="SetupPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
            <TextBlock Text="Welcome to BitLife Clone!" FontSize="20" HorizontalAlignment="Center" Margin="0,0,0,20"/>

            <TextBlock Text="Enter your first name:" />
            <TextBox Name="NameTextBox" Width="200" />

            <TextBlock Text="Select your gender:" Margin="0,10,0,0"/>
            <ComboBox Name="GenderComboBox" Width="200" SelectedIndex="0">
                <ComboBoxItem>Male</ComboBoxItem>
                <ComboBoxItem>Female</ComboBoxItem>
            </ComboBox>

            <Button Content="Start Game" Name="StartButton" HorizontalAlignment="Center" Margin="0,20,0,0" Click="StartButton_Click"/>
        </StackPanel>

        <!-- Main Game Screen -->
        <Grid Name="GamePanel" IsVisible="False" Margin="10" RowDefinitions="Auto,*">
            <!-- Stats (Always Visible) -->
            <StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,10">
                <TextBlock Name="NameGenderAgeBlock" FontWeight="Bold" FontSize="16" />
                <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto,*">
                    <TextBlock Grid.Column="0" Text="Health: " FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Name="HealthBlock" />

                    <TextBlock Grid.Column="2" Text=" Happiness: " FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="3" Name="HappinessBlock" />

                    <TextBlock Grid.Column="4" Text=" Smarts: " FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="5" Name="SmartsBlock" />

                    <TextBlock Grid.Column="6" Text=" Looks: " FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="7" Name="LooksBlock" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="Money: " FontWeight="SemiBold" />
                    <TextBlock Name="MoneyBlock" />
                    <TextBlock Text=" | Education: " FontWeight="SemiBold" Margin="10,0,0,0" />
                    <TextBlock Name="EducationBlock" />
                    <TextBlock Text=" | Job: " FontWeight="SemiBold" Margin="10,0,0,0" />
                    <TextBlock Name="JobBlock" />
                </StackPanel>
            </StackPanel>

            <TabControl Grid.Row="1">
                <!-- Main & Log Tab -->
                <TabItem Header="Main &amp; Log">
                    <Grid RowDefinitions="*,Auto">
                        <ListBox Grid.Row="0" Name="ActivityLog" Margin="0,10,0,10" Background="#1E1E1E" Foreground="White">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="5,2" />
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                            <Button Name="AgeUpButton" Content="Age Up" Click="AgeUpButton_Click" Background="#4CAF50" Foreground="White" />
                            <Button Name="RestartButton" Content="Restart" Click="RestartButton_Click" IsVisible="False" Background="#F44336" Foreground="White"/>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <!-- Activities Tab -->
                <TabItem Header="Activities">
                    <StackPanel Spacing="10" Margin="10">
                        <Button Name="GymButton" Content="Go to Gym" Click="GymButton_Click" Width="200"/>
                        <Button Name="BookButton" Content="Read a Book" Click="BookButton_Click" Width="200"/>
                    </StackPanel>
                </TabItem>

                <!-- Education & Occupation Tab -->
                <TabItem Header="Education &amp; Occupation">
                    <StackPanel Spacing="10" Margin="10">
                        <TextBlock Text="Education" FontWeight="Bold" FontSize="14" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Name="EnrollElementaryButton" Content="Enroll Elementary" Click="EnrollElementary_Click" />
                            <Button Name="EnrollHighSchoolButton" Content="Enroll High School" Click="EnrollHighSchool_Click" />
                            <Button Name="EnrollUniversityButton" Content="Enroll University" Click="EnrollUniversity_Click" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Name="StudyButton" Content="Study Hard" Click="Study_Click" />
                            <Button Name="GraduateButton" Content="Graduate" Click="Graduate_Click" />
                        </StackPanel>

                        <TextBlock Text="Career" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" />
                        <ListBox Name="JobsList" Height="100" SelectionChanged="JobsList_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Name="ApplyJobButton" Content="Apply for Selected Job" Click="ApplyJob_Click" />
                            <Button Name="WorkButton" Content="Go to Work" Click="WorkButton_Click" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>

                <!-- Relationships Tab -->
                <TabItem Header="Relationships">
                    <StackPanel Spacing="10" Margin="10">
                        <ListBox Name="RelationshipsList" Height="150" SelectionChanged="RelationshipsList_SelectionChanged" />
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Button Name="SpendTimeButton" Content="Spend Time" Click="SpendTime_Click" />
                            <Button Name="ArgueButton" Content="Argue" Click="Argue_Click" />
                        </StackPanel>
                    </StackPanel>
                </TabItem>
            </TabControl>
        </Grid>

        <!-- Event Popup Overlay -->
        <Border Name="EventOverlay" IsVisible="False" Background="#80000000" Grid.RowSpan="3">
            <Border Background="#333333" Width="400" Height="250" CornerRadius="10" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid RowDefinitions="*,Auto">
                    <TextBlock Grid.Row="0" Name="EventPromptBlock" TextWrapping="Wrap" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Row="1" Name="EventChoicesPanel" Orientation="Vertical" Spacing="10" />
                </Grid>
            </Border>
        </Border>
    </Grid>
</Window>
