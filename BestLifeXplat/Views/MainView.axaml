<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="BestLifeXplat.Views.MainView"
             Background="#0f172a">
    
	<Grid>
		<Border Name="SetupPanel" Background="#1e293b" CornerRadius="12" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
			<StackPanel Spacing="10">
				<TextBlock Text="Welcome to Bestlife!" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20"/>

				<TextBlock Text="Select your gender:" Margin="0,10,0,0"/>
				<ComboBox Name="GenderComboBox" Width="200" SelectedIndex="0">
					<ComboBoxItem>Male</ComboBoxItem>
					<ComboBoxItem>Female</ComboBoxItem>
				</ComboBox>

				<Button Content="Start Game" Name="StartButton" HorizontalAlignment="Center" Margin="0,20,0,0" Click="StartButton_Click" Background="#3b82f6" Foreground="White"/>
			</StackPanel>
		</Border>

		<Grid Name="GamePanel" IsVisible="False" Margin="10" RowDefinitions="Auto, *, Auto, Auto">
			
			<StackPanel Grid.Row="0" Spacing="5" Margin="0,0,0,10">
				<TextBlock Name="NameGenderAgeBlock" FontWeight="Bold" FontSize="16" TextWrapping="Wrap"/>
				
				<Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto">
					<Grid Grid.Row="0" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,5,10">
						<TextBlock Grid.Column="0" Text="Health: " FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
						<ProgressBar Grid.Column="1" Name="HealthBar" Minimum="0" Maximum="100" Foreground="#10b981" VerticalAlignment="Center" Height="8" Margin="5,0" MinWidth="10"/>
						<TextBlock Grid.Column="2" Name="HealthBlock" VerticalAlignment="Center" FontSize="12"/>
					</Grid>

					<Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="5,0,0,10">
						<TextBlock Grid.Column="0" Text="Happy: " FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
						<ProgressBar Grid.Column="1" Name="HappinessBar" Minimum="0" Maximum="100" Foreground="#f59e0b" VerticalAlignment="Center" Height="8" Margin="5,0" MinWidth="10"/>
						<TextBlock Grid.Column="2" Name="HappinessBlock" VerticalAlignment="Center" FontSize="12"/>
					</Grid>

					<Grid Grid.Row="1" Grid.Column="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,5,0">
						<TextBlock Grid.Column="0" Text="Smarts: " FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
						<ProgressBar Grid.Column="1" Name="SmartsBar" Minimum="0" Maximum="100" Foreground="#3b82f6" VerticalAlignment="Center" Height="8" Margin="5,0" MinWidth="10"/>
						<TextBlock Grid.Column="2" Name="SmartsBlock" VerticalAlignment="Center" FontSize="12"/>
					</Grid>

					<Grid Grid.Row="1" Grid.Column="1" ColumnDefinitions="Auto,*,Auto" Margin="5,0,0,0">
						<TextBlock Grid.Column="0" Text="Looks: " FontWeight="SemiBold" VerticalAlignment="Center" FontSize="12"/>
						<ProgressBar Grid.Column="1" Name="LooksBar" Minimum="0" Maximum="100" Foreground="#ec4899" VerticalAlignment="Center" Height="8" Margin="5,0" MinWidth="10"/>
						<TextBlock Grid.Column="2" Name="LooksBlock" VerticalAlignment="Center" FontSize="12"/>
					</Grid>
				</Grid>
				
				<WrapPanel Margin="0,5,0,0">
					<StackPanel Orientation="Horizontal" Margin="0,0,10,5">
						<TextBlock Text="Money: " FontWeight="Bold" Foreground="#3b82f6"/>
						<TextBlock Name="MoneyBlock" FontWeight="SemiBold"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,10,5">
						<TextBlock Text="Edu: " FontWeight="Bold" Foreground="#3b82f6"/>
						<TextBlock Name="EducationBlock" FontWeight="SemiBold"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,0,5">
						<TextBlock Text="Job: " FontWeight="Bold" Foreground="#3b82f6"/>
						<TextBlock Name="JobBlock" FontWeight="SemiBold"/>
					</StackPanel>
				</WrapPanel>
			</StackPanel>

			<Grid Grid.Row="1" Margin="0,10">
				<ListBox Name="ActivityLog" Background="#1e293b" Foreground="White" BorderThickness="0" CornerRadius="8">
					<ListBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="5,2" />
						</DataTemplate>
					</ListBox.ItemTemplate>
				</ListBox>

				<ScrollViewer Name="ActivitiesPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="10">
						<Button Content="&lt;- Back" Click="BackButton_Click" HorizontalAlignment="Left" Margin="0,0,0,10" />
						<TabControl Name="ActivitiesTabControl">
							<TabItem Header="Health and Wellness">
								<StackPanel Spacing="10">
									<Button Name="GymButton" Content="Go to Gym" Click="GymButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
									<Button Name="BookButton" Content="Read a Book" Click="BookButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
									<Button Name="DietButton" Content="Dieting" Click="DietButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
									<Button Name="GardenButton" Content="Gardening" Click="GardenButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
									<Button Name="LibraryButton" Content="Visit Library" Click="LibraryButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
									<Button Name="MeditateButton" Content="Meditating" Click="MeditateButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
									<Button Name="WalkButton" Content="Go for a Walk" Click="WalkButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
									<Button Name="IQTestButton" Content="IQ Test" Click="IQTestButton_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"/>
								</StackPanel>
							</TabItem>
							<TabItem Header="Other">
								<TextBlock Text="More activities coming soon!" Margin="10"/>
							</TabItem>
						</TabControl>
					</StackPanel>
				</ScrollViewer>

				<ScrollViewer Name="EducationPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="10">
						<Button Content="&lt;- Back" Click="BackButton_Click" HorizontalAlignment="Left" Margin="0,0,0,10" />
						<TextBlock Text="Education" FontWeight="Bold" FontSize="14" />
						
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Button Name="EnrollElementaryButton" Content="Enroll Elementary" Click="EnrollElementary_Click" />
							<Button Name="EnrollHighSchoolButton" Content="Enroll High School" Click="EnrollHighSchool_Click" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Button Name="EnrollUniversityButton" Content="Enroll University" Click="EnrollUniversity_Click" />
							<Button Name="StudyButton" Content="Study Hard" Click="Study_Click" />
						</StackPanel>
						<Button Name="GraduateButton" Content="Graduate" Click="Graduate_Click" HorizontalAlignment="Left"/>

						<TextBlock Text="Career" FontWeight="Bold" FontSize="14" Margin="0,10,0,0" />
						<ListBox Name="JobsList" Height="100" SelectionChanged="JobsList_SelectionChanged" />
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Button Name="ApplyJobButton" Content="Apply" Click="ApplyJob_Click" />
							<Button Name="WorkButton" Content="Go to Work" Click="WorkButton_Click" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>

				<ScrollViewer Name="RelationshipsPanel" IsVisible="False" VerticalScrollBarVisibility="Auto">
					<StackPanel Spacing="10">
						<Button Content="&lt;- Back" Click="BackButton_Click" HorizontalAlignment="Left" Margin="0,0,0,10" />
						<ListBox Name="RelationshipsList" Height="150" SelectionChanged="RelationshipsList_SelectionChanged" />
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Button Name="SpendTimeButton" Content="Spend Time" Click="SpendTime_Click" />
							<Button Name="ArgueButton" Content="Argue" Click="Argue_Click" />
						</StackPanel>
						<StackPanel Orientation="Horizontal" Spacing="10">
							<Button Name="AskMoneyButton" Content="Ask for Money" Click="AskMoney_Click" />
							<Button Name="ComplimentButton" Content="Compliment" Click="Compliment_Click" />
						</StackPanel>
					</StackPanel>
				</ScrollViewer>
			</Grid>

			<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,0,0,10">
				<Button Name="AgeUpButton" Content="Age Up" Click="AgeUpButton_Click" Background="#4CAF50" Foreground="White" Width="120" HorizontalContentAlignment="Center"/>
				<Button Name="RestartButton" Content="Restart" Click="RestartButton_Click" IsVisible="False" Background="#F44336" Foreground="White" Width="120" HorizontalContentAlignment="Center"/>
			</StackPanel>

			<Grid Grid.Row="3" Name="MainMenuPanel" ColumnDefinitions="*,*,*">
				<Button Grid.Column="0" Name="ShowActivitiesButton" Content="Activities" Click="ShowActivities_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,2,0"/>
				<Button Grid.Column="1" Name="ShowEducationButton" Content="Education" Click="ShowEducation_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,2,0"/>
				<Button Grid.Column="2" Name="ShowRelationshipsButton" Content="Relations" Click="ShowRelationships_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,0,0"/>
			</Grid>
			
		</Grid>

		<Border Name="EventOverlay" IsVisible="False" Background="#B3000000" Grid.RowSpan="3">
			<Border Background="#1e293b" Width="400" Height="250" CornerRadius="16" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
				<Grid RowDefinitions="*,Auto">
					<TextBlock Grid.Row="0" Name="EventPromptBlock" TextWrapping="Wrap" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					<StackPanel Grid.Row="1" Name="EventChoicesPanel" Orientation="Vertical" Spacing="10" />
				</Grid>
			</Border>
		</Border>

		<Border Name="IQTestOverlay" IsVisible="False" Background="#B3000000" Grid.RowSpan="3">
			<Border Background="#1e293b" Width="500" Height="300" CornerRadius="16" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
				<Grid RowDefinitions="Auto,*,Auto">
					<TextBlock Grid.Row="0" Text="IQ Test" FontWeight="Bold" FontSize="20" Foreground="White" HorizontalAlignment="Center" Margin="0,0,0,10"/>
					<TextBlock Grid.Row="1" Name="IQTestQuestionBlock" TextWrapping="Wrap" Foreground="White" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					<StackPanel Grid.Row="2" Name="IQTestChoicesPanel" Orientation="Vertical" Spacing="10" />
				</Grid>
			</Border>
		</Border>

		<Border Name="ComplimentOverlay" IsVisible="False" Background="#B3000000" Grid.RowSpan="3">
			<Border Background="#1e293b" Width="400" Height="250" CornerRadius="16" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center">
				<Grid RowDefinitions="*,Auto,Auto">
					<TextBlock Grid.Row="0" Name="ComplimentResultBlock" TextWrapping="Wrap" Foreground="White" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center"/>
					<ProgressBar Grid.Row="1" Name="ComplimentProgressBar" Minimum="0" Maximum="100" Height="20" Margin="0,20,0,20" />
					<Button Grid.Row="2" Content="OK" Click="ComplimentOK_Click" HorizontalAlignment="Center" Width="100" HorizontalContentAlignment="Center"/>
				</Grid>
			</Border>
		</Border>
	</Grid>
</UserControl>